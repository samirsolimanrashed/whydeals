generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String?
  name          String?
  phone         String?
  avatar        String?
  role          String         @default("CUSTOMER")
  verified      Boolean        @default(false)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  favorites     Favorite[]
  notifications Notification[]
  purchases     Purchase[]
  reviews       Review[]
  sellerProfile SellerProfile?
  sessions      Session[]
  wallet        Wallet?

  @@index([email])
  @@index([role])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SellerProfile {
  id              String           @id @default(cuid())
  userId          String           @unique
  businessName    String
  businessEmail   String?
  phone           String?
  logo            String?
  banner          String?
  bio             String?
  website         String?
  approved        Boolean          @default(false)
  rejectionReason String?
  verifiedAt      DateTime?
  totalDeals      Int              @default(0)
  totalSales      Float            @default(0)
  rating          Float            @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deals           Deal[]
  payoutAccount   PayoutAccount?
  analytics       SellerAnalytics?
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([approved])
}

model PayoutAccount {
  id            String        @id @default(cuid())
  sellerId      String        @unique
  accountHolder String
  bankName      String?
  accountNumber String
  routingNumber String?
  accountType   String
  country       String
  verified      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  seller        SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

model Deal {
  id                 String        @id @default(cuid())
  title              String
  description        String
  category           String?
  image              String?
  imageUrl           String?
  originalPrice      Float
  discountPrice      Float
  platformFeePercent Float         @default(10)
  startTime          DateTime
  endTime            DateTime
  status             String        @default("DRAFT")
  isFeatured         Boolean       @default(false)
  inventory          Int           @default(1)
  sold               Int           @default(0)
  sellerId           String
  views              Int           @default(0)
  clicks             Int           @default(0)
  shares             Int           @default(0)
  conversionRate     Float         @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  seller             SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  favorites          Favorite[]
  purchases          Purchase[]
  reviews            Review[]

  @@index([sellerId])
  @@index([status])
  @@index([endTime])
  @@index([category])
}

model Purchase {
  id              String    @id @default(cuid())
  userId          String
  dealId          String
  quantity        Int       @default(1)
  subtotal        Float
  platformFee     Float
  total           Float
  status          String    @default("PENDING")
  stripeId        String?
  transactionId   String?
  paymentProvider String    @default("STRIPE")
  paymentMethod   String?
  redeemed        Boolean   @default(false)
  redeemedAt      DateTime?
  couponCode      String?
  refunded        Boolean   @default(false)
  refundReason    String?
  refundedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deal            Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dealId])
  @@index([status])
  @@index([createdAt])
}

model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  balance      Float               @default(0)
  currency     String              @default("USD")
  locked       Float               @default(0)
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id            String   @id @default(cuid())
  walletId      String
  type          String
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  note          String?
  referenceId   String?
  createdAt     DateTime @default(now())
  wallet        Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type])
}

model Review {
  id           String   @id @default(cuid())
  dealId       String
  userId       String
  rating       Int
  comment      String?
  verified     Boolean  @default(true)
  helpfulCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal         Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([dealId, userId])
  @@index([dealId])
  @@index([rating])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  dealId    String
  createdAt DateTime @default(now())
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dealId])
  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  content   String
  link      String?
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

model SellerAnalytics {
  id                String        @id @default(cuid())
  sellerId          String        @unique
  totalDealsCreated Int           @default(0)
  totalRevenue      Float         @default(0)
  totalOrders       Int           @default(0)
  totalViews        Int           @default(0)
  totalClicks       Int           @default(0)
  averageRating     Float         @default(0)
  completionRate    Float         @default(0)
  refundRate        Float         @default(0)
  updatedAt         DateTime      @updatedAt
  seller            SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

model AdminSettings {
  id                        String    @id @default(cuid())
  platformFeePercent        Float     @default(10)
  minSellerPayout           Float     @default(100)
  payoutFrequency           String    @default("WEEKLY")
  allowNewSellers           Boolean   @default(true)
  allowNewDeals             Boolean   @default(true)
  maintenanceMode           Boolean   @default(false)
  forcedMaintenanceTime     DateTime?
  passwordExpireDays        Int       @default(90)
  maxLoginAttempts          Int       @default(5)
  lockoutDurationMinutes    Int       @default(30)
  emailNotificationsEnabled Boolean   @default(true)
  smsNotificationsEnabled   Boolean   @default(false)
  updatedAt                 DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  details   String
  createdAt DateTime @default(now())

  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

model Coupon {
  id                String   @id @default(cuid())
  code              String   @unique
  description       String?
  discountType      String
  discountValue     Float
  maxUses           Int?
  maxUsesPerUser    Int      @default(1)
  minPurchaseAmount Float    @default(0)
  validFrom         DateTime
  validUntil        DateTime
  active            Boolean  @default(true)
  timesUsed         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([code])
  @@index([active])
}
