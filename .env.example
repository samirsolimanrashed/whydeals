# Database
DATABASE_URL="file:./dev.db"

# Firebase (client + admin)
NEXT_PUBLIC_FIREBASE_API_KEY=your_public_api_key_here
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_CLIENT_EMAIL=your_service_account_email@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_secure_value

# 2Checkout
TWOCHECKOUT_MERCHANT_CODE=your_merchant_code
TWOCHECKOUT_SECRET_KEY=your_secret_key

# SMTP Email (for transactional emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3006

# UploadThing (for cloud file uploads)
UPLOADTHING_SECRET=sk_live_...
UPLOADTHING_APP_ID=your_app_id

# Optional
#LOG_LEVEL=info
